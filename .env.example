# ── Gemini API ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── FHIR Server ────────────────────────────────────────────────────────────────
# For local demo: use HAPI FHIR (docker-compose up -d)
FHIR_BASE_URL=http://localhost:8080/fhir
FHIR_ACCESS_TOKEN=demo_token

# ── SMART on FHIR ──────────────────────────────────────────────────────────────
SMART_CLIENT_ID=vitalshield
SMART_CLIENT_SECRET=
SMART_REDIRECT_URI=http://localhost:8000/callback

# ── VitalShield Server ─────────────────────────────────────────────────────────
VITALSHIELD_HOST=0.0.0.0
VITALSHIELD_PORT=8000
VITALSHIELD_LOG_LEVEL=INFO

# ── Temporal Engine ────────────────────────────────────────────────────────────
TEMPORAL_WINDOW_HOURS=72
TEMPORAL_MAX_GAP_MINUTES=30

# ── Privacy / Crypto ───────────────────────────────────────────────────────────
HE_ENABLED=true
ZK_ENABLED=false          # requires circom + snarkjs installed via npm

# ── Demo Mode ──────────────────────────────────────────────────────────────────
# In demo mode, uses local Synthea FHIR bundles instead of a live FHIR server
DEMO_MODE=true
DEMO_DATA_PATH=./data/synthea/fhir
